Package: anxlex
Type: Package
Title: Lexico Emocional para Estudos sobre Ansiedade
Version: 0.0.2
Authors@R: c(
    person("Maria do Carmo", "Soares de Lima", role = c("aut", "cre"),
           email = "maria@de.ufpe.br"),
    person("Pollyanna Ximenes", "Oliveira Bezerra", role = "aut"),
